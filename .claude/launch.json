{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "idie-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "idie-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "idie-preview-cold",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4176"
      ],
      "port": 4176
    },
    {
      "name": "idie-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "server"
      ],
      "port": 3001
    }
  ]
}
