# คัดลอกเป็น server/.env แล้วแก้ค่าให้ตรงกับเครื่องที่รันจริง
# ไฟล์ .env ถูก ignore ไว้แล้ว — อย่า commit ค่าจริงเข้า repo

# ---- HTTP -------------------------------------------------------------------
# ถ้าเปลี่ยนพอร์ตนี้ ต้องตั้ง API_PORT ให้ตรงกันตอนรัน Vite dev server ด้วย
# (vite.config.ts ใช้ค่านั้น proxy /api และ /uploads มาที่เซิร์ฟเวอร์ตัวนี้)
PORT=3001

# ---- MySQL ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=idie
DB_PASSWORD=
DB_NAME=idie_website

# ---- Session ----------------------------------------------------------------
# สุ่มค่าใหม่ทุกการติดตั้ง เช่น:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# เปลี่ยนค่านี้ = เตะทุกคนออกจากระบบ
SESSION_SECRET=

# ตั้ง true เมื่อเสิร์ฟผ่าน https เท่านั้น — ถ้าตั้ง true บน http คุกกี้จะไม่ถูกส่งเลย
# และอาการที่เห็นคือ "ล็อกอินผ่านแต่เด้งกลับหน้า login ทันที"
SESSION_COOKIE_SECURE=false

# ---- อีเมลจากแบบฟอร์มติดต่อ ---------------------------------------------------
# ไม่บังคับ — ถ้าเว้นว่าง เซิร์ฟเวอร์ยังรันได้ แต่ฟอร์มติดต่อจะแจ้งว่าใช้ไม่ได้ชั่วคราว
#
# ตัวอย่างถ้าใช้ Gmail: ต้องเปิด 2-Step Verification แล้วสร้าง "App password"
# (รหัส 16 หลัก) มาใส่ใน SMTP_PASSWORD — ใช้รหัสผ่านปกติของบัญชีไม่ได้
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#
# ถ้าใช้เมลเซิร์ฟเวอร์ของบริษัท ให้ถามผู้ดูแลระบบว่า host/port/บัญชีคืออะไร
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ผู้ส่งที่แสดงในจดหมาย — เว้นว่างได้ จะใช้ค่า SMTP_USER แทน
# **ต้องเป็นบัญชีของเราเอง** ห้ามใส่อีเมลของผู้กรอกฟอร์ม ไม่งั้นจดหมายจะไม่ผ่าน
# SPF/DKIM ของโดเมนเขาแล้วตกถังขยะหรือถูกปฏิเสธ
MAIL_FROM=

# ปลายทางที่รับคำถามจากเว็บ
MAIL_TO=pitthaya.rayong@gmail.com

# ---- ไฟล์ที่อัปโหลด ----------------------------------------------------------
# โฟลเดอร์บนดิสก์ที่เก็บรูปจริง (เก็บเป็น local path ตามที่ตกลงไว้ ไม่ใช้ object storage)
# path สัมพัทธ์นับจากโฟลเดอร์ server/ — ใส่ absolute path ได้ถ้าต้องการเก็บนอกโปรเจกต์
UPLOAD_DIR=uploads
# ขนาดไฟล์สูงสุดต่อรูป (MB) ก่อนถูกย่อ
UPLOAD_MAX_MB=12
